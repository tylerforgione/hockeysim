<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:saves="using:HockeySim.Desktop.Saves"
             xmlns:theme="using:HockeySim.Desktop.Theme"
             x:Class="HockeySim.Desktop.Saves.SavedGameRowView"
             x:DataType="saves:SavedGameRowViewModel">
  <Grid x:Name="RowGrid" ColumnSpacing="8">
    <TextBlock Classes="strong" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsVisible="{Binding HasDetails}">
        <Border Classes="team-swatch"
                Background="{Binding PrimaryColour, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
        <Border Classes="team-swatch"
                Background="{Binding SecondaryColour, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
      </StackPanel>
      <TextBlock Classes.muted="{Binding !HasDetails}"
                 Text="{Binding TeamName}"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <TextBlock Grid.Column="2" Text="{Binding DateLabel}" VerticalAlignment="Center" />
    <TextBlock Grid.Column="3" Text="{Binding RecordLabel}" VerticalAlignment="Center" />
    <TextBlock Grid.Column="4" Text="{Binding StandingLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    <TextBlock Grid.Column="5" Classes="muted" Text="{Binding SavedAtLabel}" VerticalAlignment="Center" />
  </Grid>
</UserControl>
