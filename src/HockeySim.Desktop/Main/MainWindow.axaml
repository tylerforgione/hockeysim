<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="using:HockeySim.Desktop.Main"
        xmlns:newGame="using:HockeySim.Desktop.NewGame"
        x:Class="HockeySim.Desktop.Main.MainWindow"
        x:DataType="main:MainWindowViewModel"
        Title="HockeySim"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="640"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="238,*">
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="24,30">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="32"
                    Height="32"
                    CornerRadius="16"
                    Background="{DynamicResource AccentBrush}">
              <TextBlock Text="●"
                         Foreground="#04101C"
                         FontSize="17"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="HOCKEYSIM"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Margin="42,0,0,0"
                     Classes="muted"
                     FontSize="11"
                     Text="FRONT OFFICE" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,62,0,0" Spacing="10">
          <Border Background="#172B40" CornerRadius="8" Padding="12,10">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="01" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
              <TextBlock Text="New game" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
          <StackPanel Margin="12,10,0,0" Spacing="18" Opacity="0.46">
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="02" />
              <TextBlock Text="Team hub" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="03" />
              <TextBlock Text="Roster" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="11">
              <TextBlock Text="04" />
              <TextBlock Text="Lineup" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12">
          <StackPanel Spacing="3">
            <TextBlock Text="OFFLINE CAREER" FontSize="11" FontWeight="Bold" />
            <TextBlock Text="Your world stays on this device." Classes="muted" FontSize="11" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <newGame:NewGameView Grid.Column="1" DataContext="{Binding NewGame}" />
  </Grid>
</Window>
