<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:main="using:HockeySim.Desktop.Main"
        xmlns:newGame="using:HockeySim.Desktop.NewGame"
        xmlns:startup="using:HockeySim.Desktop.Startup"
        x:Class="HockeySim.Desktop.Main.MainWindow"
        x:DataType="main:MainWindowViewModel"
        Title="HockeySim"
        Width="1280"
        Height="800"
        MinWidth="1024"
        MinHeight="700"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid IsVisible="{Binding IsStartupVisible}">
      <startup:StartupView DataContext="{Binding Startup}" />
    </Grid>
    <Grid IsVisible="{Binding IsNewGameVisible}">
      <newGame:NewGameView DataContext="{Binding NewGame}" />
    </Grid>
  </Grid>
</Window>
