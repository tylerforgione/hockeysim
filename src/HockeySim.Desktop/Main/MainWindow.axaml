<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:game="using:HockeySim.Desktop.Game"
        xmlns:main="using:HockeySim.Desktop.Main"
        xmlns:newGame="using:HockeySim.Desktop.NewGame"
        xmlns:saves="using:HockeySim.Desktop.Saves"
        xmlns:startup="using:HockeySim.Desktop.Startup"
        x:Class="HockeySim.Desktop.Main.MainWindow"
        x:DataType="main:MainWindowViewModel"
        Title="HockeySim"
        Width="1440"
        Height="900"
        MinWidth="1200"
        MinHeight="760"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate x:DataType="startup:StartupViewModel">
      <startup:StartupView />
    </DataTemplate>
    <DataTemplate x:DataType="newGame:NewGameViewModel">
      <newGame:NewGameView />
    </DataTemplate>
    <DataTemplate x:DataType="saves:LoadGameViewModel">
      <saves:LoadGameView />
    </DataTemplate>
    <DataTemplate x:DataType="game:GameShellViewModel">
      <game:GameShellView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <ContentControl Content="{Binding CurrentScreen}" />

    <!-- Confirmation over every screen; it blocks the screen beneath until answered. -->
    <Border x:Name="ConfirmationOverlay"
            Background="#B3000000"
            IsVisible="{Binding Confirmation.IsOpen}">
      <Border Classes="panel"
              Width="460"
              Padding="20"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock x:Name="ConfirmationTitle"
                     FontSize="16"
                     FontWeight="Bold"
                     Text="{Binding Confirmation.Current.Title}" />
          <TextBlock x:Name="ConfirmationMessage"
                     TextWrapping="Wrap"
                     Text="{Binding Confirmation.Current.Message}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button x:Name="CancelConfirmationButton"
                    Classes="secondary"
                    Content="Cancel"
                    Command="{Binding Confirmation.CancelCommand}" />
            <Button x:Name="ConfirmButton"
                    Classes="primary"
                    Content="{Binding Confirmation.Current.ConfirmLabel}"
                    Command="{Binding Confirmation.ConfirmCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
