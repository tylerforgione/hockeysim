<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The front-office look: dense, square panels tiled edge to edge with 6 px gutters, headed in the
    managed team's colours. Body text is PT Sans; headings and large figures are PT Sans Narrow.
  -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource BodyFontFamily}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Text roles. -->
  <Style Selector="TextBlock.page-title">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <Style Selector="TextBlock.stat">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="TextBlock.strong">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="TextBlock.rating">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.cell">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.cell-center">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <!-- Panels: square, with 1 px dark borders. Panel titles are written in upper case. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.panel-header">
    <Setter Property="Background" Value="{DynamicResource TeamPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="30" />
  </Style>
  <Style Selector="TextBlock.panel-title">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.panel-header TextBlock.panel-title">
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
  </Style>
  <Style Selector="Border.panel-header TextBlock.caption">
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
    <Setter Property="Opacity" Value="0.75" />
  </Style>
  <Style Selector="Border.table-header">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.table-header TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Badges and pills. -->
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource TeamPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="18" />
    <Setter Property="Height" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.pill.muted">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="Border.pill.muted TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
  </Style>
  <!-- Injury markers: out (cannot play) and playing hurt. -->
  <Style Selector="Border.pill.injury-out">
    <Setter Property="Background" Value="{DynamicResource NegativeBrush}" />
  </Style>
  <Style Selector="Border.pill.injury-playing">
    <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Border.pill.injury-out TextBlock, Border.pill.injury-playing TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource AppBackgroundBrush}" />
  </Style>
  <Style Selector="Border.position">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.position TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Buttons. Fluent draws the background on the template's ContentPresenter. -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="16,6" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="14,5" />
  </Style>
  <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.secondary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Padding" Value="10,5" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.flat:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <!-- In a panel header the link sits on the primary colour, so hovering brightens it instead. -->
  <Style Selector="Border.panel-header Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
  </Style>

  <!--
    Segmented button groups switch a view, such as which columns or standings a page shows. Put the
    buttons side by side with no spacing; the selected one takes the team's secondary colour.
  -->
  <Style Selector="Button.tab">
    <Setter Property="Background" Value="{DynamicResource TabStripBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
  </Style>
  <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
  </Style>

  <!-- Buttons on a bar in the team's primary colour. -->
  <Style Selector="Button.chrome">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26FFFFFF" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
  </Style>
  <Style Selector="Button.chrome:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="#66FFFFFF" />
  </Style>

  <!-- Startup menu. -->
  <Style Selector="Button.menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="42" />
  </Style>
  <Style Selector="Button.menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.menu:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- Menu bar: history and home buttons, text menus, the date, and Continue. -->
  <Style Selector="Border.menu-bar">
    <Setter Property="Background" Value="{DynamicResource MenuBarBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="6,0,0,0" />
  </Style>
  <Style Selector="Border.menu-separator">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,8" />
    <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
  </Style>
  <Style Selector="Button.menu-icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.menu-icon Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Button.menu-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.menu-icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="Button.menu-icon.active">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
  </Style>
  <Style Selector="Button.menu-icon.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
  </Style>
  <Style Selector="Border.menu-bar Menu">
    <Setter Property="Height" Value="33" />
  </Style>
  <Style Selector="Border.menu-bar Menu > MenuItem">
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="33" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>
  <Style Selector="Border.menu-bar Menu > MenuItem /template/ Popup > Border">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- Continue: a split button in the team's secondary colour. -->
  <Style Selector="Button.continue">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.continue:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Button.continue:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="Button.continue-arrow">
    <Setter Property="BorderThickness" Value="0,1,1,1" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.continue-arrow Path">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <!-- Icons follow the button's colour, which disabled styles set on its presenter instead. -->
  <Style Selector="Button.menu-icon:disabled Path, Button.continue-arrow:disabled Path">
    <Setter Property="Stroke" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="Button.continue Path.continue-glyph">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}" />
  </Style>
  <Style Selector="Button.continue:disabled Path.continue-glyph">
    <Setter Property="Fill" Value="{DynamicResource DisabledTextBrush}" />
  </Style>

  <!-- Banner under the menu bar: the team's crest, name, standing, and key figures. -->
  <Style Selector="Border.banner">
    <Setter Property="Background" Value="{DynamicResource TeamPrimaryBrush}" />
    <Setter Property="Height" Value="64" />
    <Setter Property="Padding" Value="14,0,0,0" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.crest">
    <Setter Property="Background" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="50" />
    <Setter Property="Padding" Value="0,0,0,8" />
    <Setter Property="Clip" Value="M0,0 H44 V35 L22,50 L0,35 Z" />
  </Style>
  <Style Selector="Border.crest TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamSecondaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.banner-title">
    <Setter Property="FontFamily" Value="{DynamicResource HeadingFontFamily}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.banner-caption">
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Path.banner-stripe">
    <Setter Property="Fill" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <!-- A light shade rather than black, so text on the primary stays readable on light colours. -->
  <Style Selector="Border.banner-figure">
    <Setter Property="Background" Value="#26000000" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinWidth" Value="80" />
  </Style>
  <Style Selector="TextBlock.banner-figure-label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="TextBlock.banner-figure-value">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource OnTeamPrimaryBrush}" />
  </Style>

  <!-- Page tabs for the current section. -->
  <Style Selector="Border.tab-strip">
    <Setter Property="Background" Value="{DynamicResource TabStripBrush}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Button.page-tab">
    <Setter Property="Background" Value="{DynamicResource MenuBarBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.page-tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.page-tab:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MenuBarBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
  </Style>
  <Style Selector="Button.page-tab.active">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.page-tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!-- Status bar. -->
  <Style Selector="Border.status-bar">
    <Setter Property="Background" Value="{DynamicResource StatusBarBrush}" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style Selector="Border.status-bar TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
  </Style>
  <Style Selector="Button.status-link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.status-link.warning">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
  </Style>
  <Style Selector="Button.status-link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>

  <!-- Rows that behave like list items outside a ListBox. -->
  <Style Selector="Button.list-item">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="10,4" />
  </Style>
  <Style Selector="Button.list-item:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
  </Style>
  <Style Selector="Button.list-item.selected">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.list-item.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
  </Style>

  <!-- Tables. -->
  <Style Selector="ListBox.table">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem">
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:nth-child(2n)">
    <Setter Property="Background" Value="{DynamicResource RowAltBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
  </Style>
  <Style Selector="ListBox.table ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
  </Style>
  <Style Selector="ListBox.table.tall ListBoxItem">
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="10,8" />
  </Style>

  <!-- Zebra stripes for rows drawn outside a ListBox; the managed team's row stands out. -->
  <Style Selector="ItemsControl.table ContentPresenter:nth-child(2n) > Border.standing-row">
    <Setter Property="Background" Value="{DynamicResource RowAltBrush}" />
  </Style>
  <Style Selector="Border.standing-row.managed">
    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TeamSecondaryBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>

  <!-- Inputs. -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="6,0,2,0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinHeight" Value="22" />
  </Style>

  <Style Selector="ProgressBar.rating-bar">
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="100" />
    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
</Styles>
