<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:players="using:HockeySim.Desktop.Players"
             xmlns:roster="using:HockeySim.Desktop.Roster"
             x:Class="HockeySim.Desktop.Roster.TeamRosterView"
             x:DataType="roster:TeamRosterViewModel">
  <!-- Header and row templates share each table's ColumnDefinitions so columns align. -->
  <Grid ColumnDefinitions="*,280" ColumnSpacing="8">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
      <Border x:Name="TeamStatistics" Classes="panel" Padding="12,6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Classes="panel-title"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     Text="TEAM"
                     ToolTip.Tip="{Binding TeamStatisticsDescription}" />
          <!-- Switches the strip, both tables, and the profile between the two sets of totals. -->
          <StackPanel DockPanel.Dock="Right"
                      Orientation="Horizontal"
                      Spacing="2"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasPlayoffStatistics}">
            <Button x:Name="ShowRegularSeasonButton"
                    Classes="tab"
                    Classes.selected="{Binding ShowsRegularSeason}"
                    Content="Regular season"
                    ToolTip.Tip="Show regular-season statistics"
                    Command="{Binding ShowStatisticsSetCommand}"
                    CommandParameter="{x:Static players:StatisticsSet.RegularSeason}" />
            <Button x:Name="ShowPlayoffsButton"
                    Classes="tab"
                    Classes.selected="{Binding ShowsPlayoffs}"
                    Content="Playoffs"
                    ToolTip.Tip="Show playoff statistics"
                    Command="{Binding ShowStatisticsSetCommand}"
                    CommandParameter="{x:Static players:StatisticsSet.Playoffs}" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding TeamStatistics}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="20" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="players:SeasonStatViewModel">
                <StackPanel Spacing="1" ToolTip.Tip="{Binding Description}">
                  <TextBlock Classes="label" Text="{Binding Label}" />
                  <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <Border x:Name="InjuryReport" Grid.Row="1" Classes="panel" Padding="12,6">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left"
                     Classes="panel-title"
                     Margin="0,0,16,0"
                     Text="INJURIES"
                     ToolTip.Tip="Injuries that have not healed, with the staff's expected return" />
          <TextBlock Classes="caption" Text="No injuries." IsVisible="{Binding !HasInjuries}" />
          <ItemsControl ItemsSource="{Binding InjuryReport}" IsVisible="{Binding HasInjuries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="roster:InjuryReportRowViewModel">
                <Grid ColumnDefinitions="180,36,150,110,*" Margin="0,1">
                  <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Classes="cell muted" Text="{Binding Position}" />
                  <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Injury}" />
                  <TextBlock Grid.Column="3"
                             Classes="cell"
                             Classes.error="{Binding IsOut}"
                             Classes.warning="{Binding !IsOut}"
                             Text="{Binding Status}" />
                  <TextBlock Grid.Column="4" Classes="cell muted" Text="{Binding ExpectedReturn, StringFormat='Expected back {0}'}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </DockPanel>
      </Border>

      <Border Grid.Row="2" Classes="panel">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-header">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
              <TextBlock Classes="panel-title" Text="SKATERS" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="ShowRatingsButton"
                        Classes="tab"
                        Classes.selected="{Binding ShowsRatings}"
                        Content="Ratings"
                        ToolTip.Tip="Show skater and goalie ratings"
                        Command="{Binding ShowColumnsCommand}"
                        CommandParameter="{x:Static roster:RosterColumns.Ratings}" />
                <Button x:Name="ShowBasicButton"
                        Classes="tab"
                        Classes.selected="{Binding ShowsBasic}"
                        Content="Basic"
                        ToolTip.Tip="Show counting totals and rates"
                        Command="{Binding ShowColumnsCommand}"
                        CommandParameter="{x:Static roster:RosterColumns.Basic}" />
                <Button x:Name="ShowAdvancedButton"
                        Classes="tab"
                        Classes.selected="{Binding ShowsAdvanced}"
                        Content="Advanced"
                        ToolTip.Tip="Show 5-on-5 on-ice shares and expected goals"
                        Command="{Binding ShowColumnsCommand}"
                        CommandParameter="{x:Static roster:RosterColumns.Advanced}" />
              </StackPanel>
              <TextBlock Grid.Column="2" Classes="caption" VerticalAlignment="Center" Text="{Binding Skaters.Count, StringFormat='{}{0} players'}" />
            </Grid>
          </Border>
          <Panel>
            <DockPanel IsVisible="{Binding ShowsRatings}">
              <Border DockPanel.Dock="Top" Classes="table-header">
                <Grid ColumnDefinitions="36,*,36,38,40,30,64,38,38,38,38,38,38,38,38,38,38,38">
                  <TextBlock Text="#" />
                  <TextBlock Grid.Column="1" Text="NAME" />
                  <TextBlock Grid.Column="2" Text="POS" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="AGE" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="NAT" HorizontalAlignment="Center" ToolTip.Tip="Nationality" />
                  <TextBlock Grid.Column="5" Text="SH" HorizontalAlignment="Center" ToolTip.Tip="Shoots" />
                  <TextBlock Grid.Column="6" Text="LINEUP" />
                  <TextBlock Grid.Column="7" Text="OVR" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="8" Text="SKA" HorizontalAlignment="Center" ToolTip.Tip="Skating" />
                  <TextBlock Grid.Column="9" Text="SHP" HorizontalAlignment="Center" ToolTip.Tip="Shot power" />
                  <TextBlock Grid.Column="10" Text="SHA" HorizontalAlignment="Center" ToolTip.Tip="Shot accuracy" />
                  <TextBlock Grid.Column="11" Text="PUC" HorizontalAlignment="Center" ToolTip.Tip="Puck control" />
                  <TextBlock Grid.Column="12" Text="PAS" HorizontalAlignment="Center" ToolTip.Tip="Passing" />
                  <TextBlock Grid.Column="13" Text="OFF" HorizontalAlignment="Center" ToolTip.Tip="Offensive awareness" />
                  <TextBlock Grid.Column="14" Text="DEF" HorizontalAlignment="Center" ToolTip.Tip="Defensive awareness" />
                  <TextBlock Grid.Column="15" Text="CHK" HorizontalAlignment="Center" ToolTip.Tip="Checking" />
                  <TextBlock Grid.Column="16" Text="BLK" HorizontalAlignment="Center" ToolTip.Tip="Shot blocking" />
                  <TextBlock Grid.Column="17" Text="STK" HorizontalAlignment="Center" ToolTip.Tip="Stick checking" />
                </Grid>
              </Border>
              <ListBox x:Name="SkatersTable"
                       Classes="table"
                       ItemsSource="{Binding Skaters}"
                       SelectedItem="{Binding SelectedSkater}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="roster:PlayerRowViewModel">
                    <Grid ColumnDefinitions="36,*,36,38,40,30,64,38,38,38,38,38,38,38,38,38,38,38">
                      <TextBlock Classes="cell muted" Text="{Binding Number}" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.injury-out="{Binding IsOut}"
                                Classes.injury-playing="{Binding IsPlayingHurt}"
                                IsVisible="{Binding HasInjury}"
                                ToolTip.Tip="{Binding InjurySummary}">
                          <TextBlock Text="{Binding InjuryMarker}" />
                        </Border>
                      </Grid>
                      <Border Grid.Column="2" Classes="position"><TextBlock Text="{Binding Position}" /></Border>
                      <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Age}" />
                      <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Nationality}" ToolTip.Tip="{Binding NationalityName}" />
                      <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding Handedness}" />
                      <TextBlock Grid.Column="6" Classes="cell" Classes.muted="{Binding IsScratched}" Text="{Binding LineupRole}" />
                      <TextBlock Grid.Column="7" Classes="rating" FontWeight="Bold" Text="{Binding Overall}" Foreground="{Binding Overall, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="8" Classes="rating" Text="{Binding Skating}" Foreground="{Binding Skating, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="9" Classes="rating" Text="{Binding ShotPower}" Foreground="{Binding ShotPower, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="10" Classes="rating" Text="{Binding ShotAccuracy}" Foreground="{Binding ShotAccuracy, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="11" Classes="rating" Text="{Binding PuckControl}" Foreground="{Binding PuckControl, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="12" Classes="rating" Text="{Binding Passing}" Foreground="{Binding Passing, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="13" Classes="rating" Text="{Binding OffensiveAwareness}" Foreground="{Binding OffensiveAwareness, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="14" Classes="rating" Text="{Binding DefensiveAwareness}" Foreground="{Binding DefensiveAwareness, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="15" Classes="rating" Text="{Binding Checking}" Foreground="{Binding Checking, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="16" Classes="rating" Text="{Binding ShotBlocking}" Foreground="{Binding ShotBlocking, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="17" Classes="rating" Text="{Binding StickChecking}" Foreground="{Binding StickChecking, Converter={StaticResource RatingBrush}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <DockPanel IsVisible="{Binding ShowsBasic}">
              <Border DockPanel.Dock="Top" Classes="table-header">
                <Grid ColumnDefinitions="36,*,36,38,40,30,64,40,40,40,40,40,40,40,40,40,56,48">
                  <TextBlock Text="#" />
                  <TextBlock Grid.Column="1" Text="NAME" />
                  <TextBlock Grid.Column="2" Text="POS" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="AGE" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="NAT" HorizontalAlignment="Center" ToolTip.Tip="Nationality" />
                  <TextBlock Grid.Column="5" Text="SH" HorizontalAlignment="Center" ToolTip.Tip="Shoots" />
                  <TextBlock Grid.Column="6" Text="LINEUP" />
                  <TextBlock Grid.Column="7" Text="GP" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="8" Text="G" HorizontalAlignment="Center" ToolTip.Tip="Goals" />
                  <TextBlock Grid.Column="9" Text="A" HorizontalAlignment="Center" ToolTip.Tip="Assists" />
                  <TextBlock Grid.Column="10" Text="P" HorizontalAlignment="Center" ToolTip.Tip="Points" />
                  <TextBlock Grid.Column="11" Text="+/-" HorizontalAlignment="Center" ToolTip.Tip="Plus/minus" />
                  <TextBlock Grid.Column="12" Text="PIM" HorizontalAlignment="Center" ToolTip.Tip="Penalty minutes" />
                  <TextBlock Grid.Column="13" Text="PPP" HorizontalAlignment="Center" ToolTip.Tip="Power-play points" />
                  <TextBlock Grid.Column="14" Text="SHP" HorizontalAlignment="Center" ToolTip.Tip="Shorthanded points" />
                  <TextBlock Grid.Column="15" Text="S" HorizontalAlignment="Center" ToolTip.Tip="Shots on goal" />
                  <TextBlock Grid.Column="16" Text="TOI/GP" HorizontalAlignment="Center" ToolTip.Tip="Average time on ice per game" />
                  <TextBlock Grid.Column="17" Text="FO%" HorizontalAlignment="Center" ToolTip.Tip="Faceoff percentage" />
                </Grid>
              </Border>
              <ListBox x:Name="SkaterBasicTable"
                       Classes="table"
                       ItemsSource="{Binding Skaters}"
                       SelectedItem="{Binding SelectedSkater}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="roster:PlayerRowViewModel">
                    <Grid ColumnDefinitions="36,*,36,38,40,30,64,40,40,40,40,40,40,40,40,40,56,48">
                      <TextBlock Classes="cell muted" Text="{Binding Number}" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.injury-out="{Binding IsOut}"
                                Classes.injury-playing="{Binding IsPlayingHurt}"
                                IsVisible="{Binding HasInjury}"
                                ToolTip.Tip="{Binding InjurySummary}">
                          <TextBlock Text="{Binding InjuryMarker}" />
                        </Border>
                      </Grid>
                      <Border Grid.Column="2" Classes="position"><TextBlock Text="{Binding Position}" /></Border>
                      <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Age}" />
                      <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Nationality}" ToolTip.Tip="{Binding NationalityName}" />
                      <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding Handedness}" />
                      <TextBlock Grid.Column="6" Classes="cell" Classes.muted="{Binding IsScratched}" Text="{Binding LineupRole}" />
                      <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Season.GamesPlayed}" />
                      <TextBlock Grid.Column="8" Classes="cell-center" Text="{Binding Season.Goals}" />
                      <TextBlock Grid.Column="9" Classes="cell-center" Text="{Binding Season.Assists}" />
                      <TextBlock Grid.Column="10" Classes="cell-center strong" Text="{Binding Season.Points}" />
                      <TextBlock Grid.Column="11" Classes="cell-center" Text="{Binding Season.PlusMinus}" />
                      <TextBlock Grid.Column="12" Classes="cell-center" Text="{Binding Season.PenaltyMinutes}" />
                      <TextBlock Grid.Column="13" Classes="cell-center" Text="{Binding Season.PowerPlayPoints}" />
                      <TextBlock Grid.Column="14" Classes="cell-center" Text="{Binding Season.ShorthandedPoints}" />
                      <TextBlock Grid.Column="15" Classes="cell-center" Text="{Binding Season.Shots}" />
                      <TextBlock Grid.Column="16" Classes="cell-center" Text="{Binding Season.TimeOnIcePerGame}" />
                      <TextBlock Grid.Column="17" Classes="cell-center" Text="{Binding Season.FaceoffPercentage}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <DockPanel IsVisible="{Binding ShowsAdvanced}">
              <Border DockPanel.Dock="Top" Classes="table-header">
                <Grid ColumnDefinitions="36,*,36,38,40,30,64,40,40,40,48,40,40,48,48,48,52,48">
                  <TextBlock Text="#" />
                  <TextBlock Grid.Column="1" Text="NAME" />
                  <TextBlock Grid.Column="2" Text="POS" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="AGE" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="NAT" HorizontalAlignment="Center" ToolTip.Tip="Nationality" />
                  <TextBlock Grid.Column="5" Text="SH" HorizontalAlignment="Center" ToolTip.Tip="Shoots" />
                  <TextBlock Grid.Column="6" Text="LINEUP" />
                  <TextBlock Grid.Column="7" Text="GP" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="8" Text="CF" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 Corsi for: team shot attempts while on the ice" />
                  <TextBlock Grid.Column="9" Text="CA" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 Corsi against: opponent shot attempts while on the ice" />
                  <TextBlock Grid.Column="10" Text="CF%" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 Corsi percentage: share of shot attempts" />
                  <TextBlock Grid.Column="11" Text="FF" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 Fenwick for: unblocked team attempts while on the ice" />
                  <TextBlock Grid.Column="12" Text="FA" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 Fenwick against: unblocked opponent attempts while on the ice" />
                  <TextBlock Grid.Column="13" Text="FF%" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 Fenwick percentage: share of unblocked attempts" />
                  <TextBlock Grid.Column="14" Text="xGF" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 team expected goals while on the ice" />
                  <TextBlock Grid.Column="15" Text="xGA" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 opponent expected goals while on the ice" />
                  <TextBlock Grid.Column="16" Text="xGF%" HorizontalAlignment="Center" ToolTip.Tip="5-on-5 share of expected goals" />
                  <TextBlock Grid.Column="17" Text="ixG" HorizontalAlignment="Center" ToolTip.Tip="Individual expected goals from the skater's own attempts, in all situations" />
                </Grid>
              </Border>
              <ListBox x:Name="SkaterAdvancedTable"
                       Classes="table"
                       ItemsSource="{Binding Skaters}"
                       SelectedItem="{Binding SelectedSkater}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="roster:PlayerRowViewModel">
                    <Grid ColumnDefinitions="36,*,36,38,40,30,64,40,40,40,48,40,40,48,48,48,52,48">
                      <TextBlock Classes="cell muted" Text="{Binding Number}" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.injury-out="{Binding IsOut}"
                                Classes.injury-playing="{Binding IsPlayingHurt}"
                                IsVisible="{Binding HasInjury}"
                                ToolTip.Tip="{Binding InjurySummary}">
                          <TextBlock Text="{Binding InjuryMarker}" />
                        </Border>
                      </Grid>
                      <Border Grid.Column="2" Classes="position"><TextBlock Text="{Binding Position}" /></Border>
                      <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Age}" />
                      <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Nationality}" ToolTip.Tip="{Binding NationalityName}" />
                      <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding Handedness}" />
                      <TextBlock Grid.Column="6" Classes="cell" Classes.muted="{Binding IsScratched}" Text="{Binding LineupRole}" />
                      <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Season.GamesPlayed}" />
                      <TextBlock Grid.Column="8" Classes="cell-center" Text="{Binding Season.CorsiFor}" />
                      <TextBlock Grid.Column="9" Classes="cell-center" Text="{Binding Season.CorsiAgainst}" />
                      <TextBlock Grid.Column="10" Classes="cell-center strong" Text="{Binding Season.CorsiPercentage}" />
                      <TextBlock Grid.Column="11" Classes="cell-center" Text="{Binding Season.FenwickFor}" />
                      <TextBlock Grid.Column="12" Classes="cell-center" Text="{Binding Season.FenwickAgainst}" />
                      <TextBlock Grid.Column="13" Classes="cell-center" Text="{Binding Season.FenwickPercentage}" />
                      <TextBlock Grid.Column="14" Classes="cell-center" Text="{Binding Season.OnIceExpectedGoalsFor}" />
                      <TextBlock Grid.Column="15" Classes="cell-center" Text="{Binding Season.OnIceExpectedGoalsAgainst}" />
                      <TextBlock Grid.Column="16" Classes="cell-center strong" Text="{Binding Season.OnIceExpectedGoalsPercentage}" />
                      <TextBlock Grid.Column="17" Classes="cell-center" Text="{Binding Season.IndividualExpectedGoals}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>

      <Border Grid.Row="3" Classes="panel">
        <DockPanel>
          <Border DockPanel.Dock="Top" Classes="panel-header">
            <TextBlock Classes="panel-title" Text="GOALIES" />
          </Border>
          <Panel>
            <DockPanel IsVisible="{Binding ShowsRatings}">
              <Border DockPanel.Dock="Top" Classes="table-header">
                <Grid ColumnDefinitions="36,*,38,40,30,64,38,38,38,38">
                  <TextBlock Text="#" />
                  <TextBlock Grid.Column="1" Text="NAME" />
                  <TextBlock Grid.Column="2" Text="AGE" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="NAT" HorizontalAlignment="Center" ToolTip.Tip="Nationality" />
                  <TextBlock Grid.Column="4" Text="CA" HorizontalAlignment="Center" ToolTip.Tip="Catches" />
                  <TextBlock Grid.Column="5" Text="LINEUP" />
                  <TextBlock Grid.Column="6" Text="OVR" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="7" Text="REF" HorizontalAlignment="Center" ToolTip.Tip="Reflexes" />
                  <TextBlock Grid.Column="8" Text="POS" HorizontalAlignment="Center" ToolTip.Tip="Positioning" />
                  <TextBlock Grid.Column="9" Text="REB" HorizontalAlignment="Center" ToolTip.Tip="Rebound control" />
                </Grid>
              </Border>
              <ListBox x:Name="GoaliesTable"
                       Classes="table"
                       ItemsSource="{Binding Goalies}"
                       SelectedItem="{Binding SelectedGoalie}"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="roster:PlayerRowViewModel">
                    <Grid ColumnDefinitions="36,*,38,40,30,64,38,38,38,38">
                      <TextBlock Classes="cell muted" Text="{Binding Number}" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.injury-out="{Binding IsOut}"
                                Classes.injury-playing="{Binding IsPlayingHurt}"
                                IsVisible="{Binding HasInjury}"
                                ToolTip.Tip="{Binding InjurySummary}">
                          <TextBlock Text="{Binding InjuryMarker}" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Column="2" Classes="cell-center" Text="{Binding Age}" />
                      <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Nationality}" ToolTip.Tip="{Binding NationalityName}" />
                      <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Handedness}" />
                      <TextBlock Grid.Column="5" Classes="cell" Classes.muted="{Binding IsScratched}" Text="{Binding LineupRole}" />
                      <TextBlock Grid.Column="6" Classes="rating" FontWeight="Bold" Text="{Binding Overall}" Foreground="{Binding Overall, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="7" Classes="rating" Text="{Binding GoalieReflex}" Foreground="{Binding GoalieReflex, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="8" Classes="rating" Text="{Binding GoaliePositioning}" Foreground="{Binding GoaliePositioning, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="9" Classes="rating" Text="{Binding GoalieReboundControl}" Foreground="{Binding GoalieReboundControl, Converter={StaticResource RatingBrush}}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <DockPanel IsVisible="{Binding ShowsBasic}">
              <Border DockPanel.Dock="Top" Classes="table-header">
                <Grid ColumnDefinitions="36,*,38,40,30,64,40,48,48,48,56,52,40">
                  <TextBlock Text="#" />
                  <TextBlock Grid.Column="1" Text="NAME" />
                  <TextBlock Grid.Column="2" Text="AGE" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="NAT" HorizontalAlignment="Center" ToolTip.Tip="Nationality" />
                  <TextBlock Grid.Column="4" Text="CA" HorizontalAlignment="Center" ToolTip.Tip="Catches" />
                  <TextBlock Grid.Column="5" Text="LINEUP" />
                  <TextBlock Grid.Column="6" Text="GP" HorizontalAlignment="Center" ToolTip.Tip="Games played (starts)" />
                  <TextBlock Grid.Column="7" Text="SA" HorizontalAlignment="Center" ToolTip.Tip="Shots against" />
                  <TextBlock Grid.Column="8" Text="SV" HorizontalAlignment="Center" ToolTip.Tip="Saves" />
                  <TextBlock Grid.Column="9" Text="GA" HorizontalAlignment="Center" ToolTip.Tip="Goals against" />
                  <TextBlock Grid.Column="10" Text="SV%" HorizontalAlignment="Center" ToolTip.Tip="Save percentage" />
                  <TextBlock Grid.Column="11" Text="GAA" HorizontalAlignment="Center" ToolTip.Tip="Goals-against average: goals against per 60 minutes" />
                  <TextBlock Grid.Column="12" Text="SO" HorizontalAlignment="Center" ToolTip.Tip="Shutouts" />
                </Grid>
              </Border>
              <ListBox x:Name="GoalieBasicTable"
                       Classes="table"
                       ItemsSource="{Binding Goalies}"
                       SelectedItem="{Binding SelectedGoalie}"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="roster:PlayerRowViewModel">
                    <Grid ColumnDefinitions="36,*,38,40,30,64,40,48,48,48,56,52,40">
                      <TextBlock Classes="cell muted" Text="{Binding Number}" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.injury-out="{Binding IsOut}"
                                Classes.injury-playing="{Binding IsPlayingHurt}"
                                IsVisible="{Binding HasInjury}"
                                ToolTip.Tip="{Binding InjurySummary}">
                          <TextBlock Text="{Binding InjuryMarker}" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Column="2" Classes="cell-center" Text="{Binding Age}" />
                      <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Nationality}" ToolTip.Tip="{Binding NationalityName}" />
                      <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Handedness}" />
                      <TextBlock Grid.Column="5" Classes="cell" Classes.muted="{Binding IsScratched}" Text="{Binding LineupRole}" />
                      <TextBlock Grid.Column="6" Classes="cell-center" Text="{Binding Season.GamesPlayed}" />
                      <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Season.ShotsAgainst}" />
                      <TextBlock Grid.Column="8" Classes="cell-center" Text="{Binding Season.Saves}" />
                      <TextBlock Grid.Column="9" Classes="cell-center" Text="{Binding Season.GoalsAgainst}" />
                      <TextBlock Grid.Column="10" Classes="cell-center strong" Text="{Binding Season.SavePercentage}" />
                      <TextBlock Grid.Column="11" Classes="cell-center" Text="{Binding Season.GoalsAgainstAverage}" />
                      <TextBlock Grid.Column="12" Classes="cell-center" Text="{Binding Season.Shutouts}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <DockPanel IsVisible="{Binding ShowsAdvanced}">
              <Border DockPanel.Dock="Top" Classes="table-header">
                <Grid ColumnDefinitions="36,*,38,40,30,64,40,64,52,48,60,56">
                  <TextBlock Text="#" />
                  <TextBlock Grid.Column="1" Text="NAME" />
                  <TextBlock Grid.Column="2" Text="AGE" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="NAT" HorizontalAlignment="Center" ToolTip.Tip="Nationality" />
                  <TextBlock Grid.Column="4" Text="CA" HorizontalAlignment="Center" ToolTip.Tip="Catches" />
                  <TextBlock Grid.Column="5" Text="LINEUP" />
                  <TextBlock Grid.Column="6" Text="GP" HorizontalAlignment="Center" ToolTip.Tip="Games played (starts)" />
                  <TextBlock Grid.Column="7" Text="TOI" HorizontalAlignment="Center" ToolTip.Tip="Total time in net" />
                  <TextBlock Grid.Column="8" Text="xGA" HorizontalAlignment="Center" ToolTip.Tip="Expected goals against: the expected-goal value of the shots faced" />
                  <TextBlock Grid.Column="9" Text="GA" HorizontalAlignment="Center" ToolTip.Tip="Goals against" />
                  <TextBlock Grid.Column="10" Text="GSAx" HorizontalAlignment="Center" ToolTip.Tip="Goals saved above expected: expected goals against less goals against" />
                  <TextBlock Grid.Column="11" Text="TOI/GP" HorizontalAlignment="Center" ToolTip.Tip="Average time in net per start" />
                </Grid>
              </Border>
              <ListBox x:Name="GoalieAdvancedTable"
                       Classes="table"
                       ItemsSource="{Binding Goalies}"
                       SelectedItem="{Binding SelectedGoalie}"
                       ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="roster:PlayerRowViewModel">
                    <Grid ColumnDefinitions="36,*,38,40,30,64,40,64,52,48,60,56">
                      <TextBlock Classes="cell muted" Text="{Binding Number}" />
                      <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,0,6,0">
                        <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                        <Border Grid.Column="1"
                                Classes="pill"
                                Classes.injury-out="{Binding IsOut}"
                                Classes.injury-playing="{Binding IsPlayingHurt}"
                                IsVisible="{Binding HasInjury}"
                                ToolTip.Tip="{Binding InjurySummary}">
                          <TextBlock Text="{Binding InjuryMarker}" />
                        </Border>
                      </Grid>
                      <TextBlock Grid.Column="2" Classes="cell-center" Text="{Binding Age}" />
                      <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Nationality}" ToolTip.Tip="{Binding NationalityName}" />
                      <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Handedness}" />
                      <TextBlock Grid.Column="5" Classes="cell" Classes.muted="{Binding IsScratched}" Text="{Binding LineupRole}" />
                      <TextBlock Grid.Column="6" Classes="cell-center" Text="{Binding Season.GamesPlayed}" />
                      <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Season.TimeInNet}" />
                      <TextBlock Grid.Column="8" Classes="cell-center" Text="{Binding Season.ExpectedGoalsAgainst}" />
                      <TextBlock Grid.Column="9" Classes="cell-center" Text="{Binding Season.GoalsAgainst}" />
                      <TextBlock Grid.Column="10" Classes="cell-center strong" Text="{Binding Season.GoalsSavedAboveExpected}" />
                      <TextBlock Grid.Column="11" Classes="cell-center" Text="{Binding Season.TimeOnIcePerGame}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>

    <Border Grid.Column="1" Classes="panel">
      <players:PlayerDetailView x:Name="PlayerDetail"
                                DataContext="{Binding SelectedPlayer}" />
    </Border>
  </Grid>
</UserControl>
