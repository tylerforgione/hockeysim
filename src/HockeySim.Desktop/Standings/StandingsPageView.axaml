<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:HockeySim.Desktop.Theme"
             xmlns:standings="using:HockeySim.Desktop.Standings"
             x:Class="HockeySim.Desktop.Standings.StandingsPageView"
             x:DataType="standings:StandingsPageViewModel">
  <!-- Header and row templates share ColumnDefinitions so columns align. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,6" Padding="8,4">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="0">
          <Button x:Name="DivisionScopeButton"
                  Classes="tab"
                  Classes.selected="{Binding IsDivisionScope}"
                  Content="Division"
                  Command="{Binding SelectScopeCommand}"
                  CommandParameter="{x:Static standings:StandingsScope.Division}" />
          <Button x:Name="WildCardScopeButton"
                  Classes="tab"
                  Classes.selected="{Binding IsWildCardScope}"
                  Content="Wild card"
                  Command="{Binding SelectScopeCommand}"
                  CommandParameter="{x:Static standings:StandingsScope.WildCard}" />
          <Button x:Name="ConferenceScopeButton"
                  Classes="tab"
                  Classes.selected="{Binding IsConferenceScope}"
                  Content="Conference"
                  Command="{Binding SelectScopeCommand}"
                  CommandParameter="{x:Static standings:StandingsScope.Conference}" />
          <Button x:Name="LeagueScopeButton"
                  Classes="tab"
                  Classes.selected="{Binding IsLeagueScope}"
                  Content="League"
                  Command="{Binding SelectScopeCommand}"
                  CommandParameter="{x:Static standings:StandingsScope.League}" />
        </StackPanel>
      </Grid>
    </Border>

    <TextBlock x:Name="PlayoffStatusLegend"
               DockPanel.Dock="Bottom"
               Classes="caption"
               Margin="8,8,8,0"
               TextWrapping="Wrap"
               Text="{x:Static standings:PlayoffStatusDisplay.Legend}" />

    <!-- Conferences side by side, each column stacking its tables. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="StandingsColumns" ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" ColumnSpacing="6" VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="standings:StandingsColumnViewModel">
            <ItemsControl ItemsSource="{Binding Tables}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="6" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="standings:StandingsTableViewModel">
                  <Border Classes="panel">
                    <StackPanel>
                      <Border Classes="panel-header">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Classes="panel-title" Text="{Binding Title, Converter={x:Static theme:UpperCaseConverter.Instance}}" />
                          <TextBlock Grid.Column="1" Classes="caption" VerticalAlignment="Center" Text="{Binding Caption}" />
                        </Grid>
                      </Border>
                      <Border Classes="table-header">
                        <Grid ColumnDefinitions="26,14,*,30,30,30,34,36,44,36,40,50,40">
                          <TextBlock Text="#" />
                          <TextBlock Grid.Column="2" Text="TEAM" />
                          <TextBlock Grid.Column="3" Text="GP" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="4" Text="W" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="5" Text="L" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="6" Text="OTL" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="7" Text="PTS" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="8" Text="P%" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="9" Text="ROW" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="10" Text="DIFF" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="11" Text="L10" HorizontalAlignment="Center" />
                          <TextBlock Grid.Column="12" Text="STRK" HorizontalAlignment="Center" />
                        </Grid>
                      </Border>
                      <ItemsControl Classes="table" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="standings:StandingsRowViewModel">
                            <Border Classes="standing-row"
                                    Classes.managed="{Binding IsManaged}"
                                    Classes.last-qualifier="{Binding IsLastQualifier}"
                                    Height="26"
                                    Padding="8,0">
                              <Grid ColumnDefinitions="26,14,*,30,30,30,34,36,44,36,40,50,40">
                                <TextBlock Classes="cell muted" Text="{Binding Rank}" />
                                <TextBlock Grid.Column="1"
                                           Classes="cell strong"
                                           Text="{Binding PlayoffMarker}"
                                           ToolTip.Tip="{Binding PlayoffStatus}" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                  <Border Classes="team-swatch"
                                          Background="{Binding TeamColour, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
                                  <Button Classes="cell-link" Command="{Binding OpenTeamCommand}">
                                    <TextBlock Classes="cell" Classes.strong="{Binding IsManaged}" Text="{Binding TeamName}" />
                                  </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding GamesPlayed}" />
                                <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Wins}" />
                                <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding Losses}" />
                                <TextBlock Grid.Column="6" Classes="cell-center" Text="{Binding OvertimeLosses}" />
                                <TextBlock Grid.Column="7" Classes="cell-center strong" Text="{Binding Points}" />
                                <TextBlock Grid.Column="8" Classes="cell-center" Text="{Binding PointsPercentage}" />
                                <TextBlock Grid.Column="9" Classes="cell-center" Text="{Binding RegulationAndOvertimeWins}" />
                                <TextBlock Grid.Column="10" Classes="cell-center" Text="{Binding GoalDifferential}" ToolTip.Tip="{Binding Goals}" />
                                <TextBlock Grid.Column="11" Classes="cell-center" Text="{Binding LastTen}" />
                                <TextBlock Grid.Column="12" Classes="cell-center" Text="{Binding Streak}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
