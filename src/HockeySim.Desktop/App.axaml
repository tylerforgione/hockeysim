<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HockeySim.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Keeps Fluent's built-in controls (focus rings, scroll bars, pop-ups) on the app palette. -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#A2AAAD"
                               AltHigh="#1A1F25"
                               AltMedium="#20262D"
                               AltMediumLow="#20262D"
                               AltLow="#20262D"
                               ChromeMedium="#2A313A"
                               ChromeMediumLow="#20262D"
                               ChromeLow="#2A313A"
                               ChromeAltLow="#DDE3E9"
                               BaseHigh="#DDE3E9"
                               RegionColor="#1A1F25"
                               ErrorText="#E07A7A" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://HockeySim/Theme/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HockeySim/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
