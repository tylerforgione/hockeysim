<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HockeySim.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <!-- Keeps Fluent's built-in controls (focus rings, scroll bars, pop-ups) on the app palette. -->
        <ColorPaletteResources x:Key="Dark"
                               Accent="#A2AAAD"
                               AltHigh="#101215"
                               AltMedium="#181B1F"
                               AltMediumLow="#181B1F"
                               AltLow="#181B1F"
                               ChromeMedium="#20242A"
                               ChromeMediumLow="#181B1F"
                               ChromeLow="#20242A"
                               ChromeAltLow="#E8EBEE"
                               BaseHigh="#E8EBEE"
                               RegionColor="#101215"
                               ErrorText="#E06464" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://HockeySim.Desktop/Theme/Controls.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HockeySim.Desktop/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
