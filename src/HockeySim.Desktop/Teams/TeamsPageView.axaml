<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:roster="using:HockeySim.Desktop.Roster"
             xmlns:teams="using:HockeySim.Desktop.Teams"
             x:Class="HockeySim.Desktop.Teams.TeamsPageView"
             x:DataType="teams:TeamsPageViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,6" Padding="12,8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
        <Border Classes="badge" Width="44" Height="44">
          <TextBlock Text="{Binding SelectedTeamInitials}" FontSize="14" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="SelectedTeamName"
                       Text="{Binding SelectedTeam.Name}"
                       FontSize="17"
                       FontWeight="SemiBold" />
            <Border Classes="pill" IsVisible="{Binding IsSelectedTeamManaged}">
              <TextBlock Text="YOU" />
            </Border>
          </StackPanel>
          <TextBlock Classes="caption">
            <Run Text="{Binding SelectedTeam.Division}" />
            <Run Text="·" />
            <Run Text="{Binding OwnershipNote}" />
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Button Classes="secondary"
                  Content="‹"
                  Padding="10,4"
                  ToolTip.Tip="Previous team"
                  Command="{Binding ShowPreviousTeamCommand}" />
          <ComboBox x:Name="TeamSelector"
                    Width="220"
                    ItemsSource="{Binding Teams}"
                    SelectedItem="{Binding SelectedTeam}"
                    MaxDropDownHeight="520">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="teams:TeamEntryViewModel">
                <TextBlock Classes="cell" Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Classes="secondary"
                  Content="›"
                  Padding="10,4"
                  ToolTip.Tip="Next team"
                  Command="{Binding ShowNextTeamCommand}" />
        </StackPanel>
      </Grid>
    </Border>
    <roster:TeamRosterView DataContext="{Binding Roster}" />
  </DockPanel>
</UserControl>
