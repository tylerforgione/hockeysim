<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:HockeySim.Desktop.NewGame"
             x:Class="HockeySim.Desktop.NewGame.NewGameView"
             x:DataType="viewModels:NewGameViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
  <Grid>
    <Grid IsVisible="{Binding IsSetupVisible}" RowDefinitions="72,*,Auto">
      <Border Grid.Row="0"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="32,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Button Classes="secondary"
                  Content="BACK"
                  Command="{Binding BackCommand}"
                  VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Text="NEW GAME"
                     Classes="title"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <TextBlock Grid.Column="2"
                     Text="CREATE A CAREER"
                     Classes="muted"
                     FontSize="11"
                     LetterSpacing="1.2"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="42,28,42,24" Spacing="24">
          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="32">
            <StackPanel Grid.Column="0" Spacing="8">
              <TextBlock Text="GAME NAME" Classes="section" />
              <TextBox x:Name="GameNameTextBox"
                       Text="{Binding GameName}"
                       MaxLength="80"
                       PlaceholderText="Enter a name" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="SELECTED TEAM" Classes="section" />
              <Border Height="42"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      Padding="12,0">
                <TextBlock Text="{Binding SelectedTeamDisplayName}"
                           VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Grid>

          <TextBlock Text="SELECT A TEAM" Classes="section" />

          <ItemsControl x:Name="ConferencesList" ItemsSource="{Binding Conferences}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="viewModels:ConferenceOptionViewModel">
                <Border Margin="0,0,18,0"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        Background="{DynamicResource PanelBrush}">
                  <StackPanel>
                    <Border Padding="14,11"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="17"
                                 FontWeight="Bold"
                                 LetterSpacing="1" />
                    </Border>

                    <ItemsControl ItemsSource="{Binding Divisions}" Margin="12">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:DivisionOptionViewModel">
                          <StackPanel Margin="0,0,12,0" Spacing="5">
                            <TextBlock Text="{Binding Name}"
                                       Classes="muted"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Margin="10,2,0,4" />
                            <ItemsControl ItemsSource="{Binding Teams}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:TeamOptionViewModel">
                                  <Button Classes="team"
                                          Classes.selected="{Binding IsSelected}"
                                          Content="{Binding Name}"
                                          Command="{Binding SelectCommand}" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,1,0,0"
              Background="{DynamicResource PanelBrush}"
              Padding="32,16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
          <TextBlock Text="{Binding ErrorMessage}"
                     IsVisible="{Binding HasError}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap"
                     VerticalAlignment="Center" />
          <Button x:Name="CreateGameButton"
                  Grid.Column="1"
                  Classes="action"
                  Content="CREATE GAME"
                  Command="{Binding CreateGameCommand}" />
        </Grid>
      </Border>
    </Grid>

    <Grid IsVisible="{Binding IsGameCreated}" Margin="64">
      <StackPanel Width="520"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="18">
        <TextBlock Text="GAME CREATED"
                   Classes="title"
                   HorizontalAlignment="Center" />
        <Border Height="1" Background="{DynamicResource BorderBrush}" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="12">
          <TextBlock Text="GAME" Classes="muted" FontWeight="Bold" />
          <TextBlock Grid.Column="1" Text="{Binding CreatedGameName}" FontWeight="Bold" />
          <TextBlock Grid.Row="1" Text="TEAM" Classes="muted" FontWeight="Bold" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CreatedTeamName}" FontWeight="Bold" />
        </Grid>
        <TextBlock Text="The game world is ready. Team management is the next screen to be implemented."
                   Classes="muted"
                   TextAlignment="Center"
                   TextWrapping="Wrap" />
        <Button Classes="secondary"
                Content="RETURN TO MAIN MENU"
                Command="{Binding BackCommand}"
                HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
