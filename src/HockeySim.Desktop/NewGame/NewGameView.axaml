<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="using:HockeySim.Desktop.NewGame"
             x:Class="HockeySim.Desktop.NewGame.NewGameView"
             x:DataType="viewModels:NewGameViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource TeamPrimaryBrush}"
            BorderBrush="{DynamicResource TeamSecondaryBrush}"
            BorderThickness="0,0,0,3"
            Height="56"
            Padding="12,0">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
        <Button Classes="chrome"
                Content="‹  Back"
                VerticalAlignment="Center"
                Command="{Binding BackCommand}" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="New Game"
                     Foreground="{DynamicResource OnTeamPrimaryBrush}"
                     FontSize="16"
                     FontWeight="Bold" />
          <TextBlock Text="Name your career and choose a club to manage"
                     Foreground="{DynamicResource OnTeamPrimaryBrush}"
                     Opacity="0.7"
                     FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource SunkenBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,10">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <TextBlock Classes="error"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
        <Button x:Name="CreateGameButton"
                Grid.Column="1"
                Classes="primary"
                Padding="24,8"
                Content="Start Career"
                Command="{Binding CreateGameCommand}" />
      </Grid>
    </Border>

    <Grid Margin="12" ColumnDefinitions="300,*" ColumnSpacing="8">
      <Border Classes="panel" VerticalAlignment="Top">
        <StackPanel>
          <Border Classes="panel-header">
            <TextBlock Classes="panel-title" Text="CAREER" />
          </Border>
          <StackPanel Margin="12" Spacing="14">
            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="GAME NAME" />
              <TextBox x:Name="GameNameTextBox"
                       Text="{Binding GameName}"
                       MaxLength="80"
                       PlaceholderText="e.g. Halifax Dynasty" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="CLUB" />
              <Border Background="{DynamicResource SunkenBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1"
                      CornerRadius="2"
                      Padding="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Border Classes="badge" Width="40" Height="40">
                    <TextBlock Text="{Binding SelectedTeamInitials}" FontSize="13" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding SelectedTeamDisplayName}"
                               FontWeight="SemiBold"
                               Classes.muted="{Binding !HasSelectedTeam}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding SelectedTeamDivision}" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock Classes="label" Text="LEAGUE" />
              <TextBlock Text="Fictional league" FontWeight="SemiBold" />
              <TextBlock Classes="caption" Text="{Binding LeagueSummary}" />
              <TextBlock Classes="caption" Text="{Binding SeasonLabel}" />
            </StackPanel>

            <TextBlock Classes="caption"
                       TextWrapping="Wrap"
                       Text="Every club starts with a generated 23-player roster and a provisional lineup. You can change lines once your career begins." />
          </StackPanel>
        </StackPanel>
      </Border>

      <ItemsControl x:Name="ConferencesList" Grid.Column="1" ItemsSource="{Binding Conferences}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2" ColumnSpacing="8" VerticalAlignment="Top" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ConferenceOptionViewModel">
            <Border Classes="panel">
              <StackPanel>
                <Border Classes="panel-header">
                  <TextBlock Classes="panel-title" Text="{Binding Name}" />
                </Border>
                <ItemsControl ItemsSource="{Binding Divisions}" Margin="0,4,0,8">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:DivisionOptionViewModel">
                      <StackPanel>
                        <TextBlock Classes="label" Text="{Binding Name}" Margin="12,8,12,4" />
                        <ItemsControl ItemsSource="{Binding Teams}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:TeamOptionViewModel">
                              <Button Classes="list-item"
                                      Classes.selected="{Binding IsSelected}"
                                      Height="30"
                                      Padding="12,0"
                                      Content="{Binding Name}"
                                      Command="{Binding SelectCommand}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </DockPanel>
</UserControl>
