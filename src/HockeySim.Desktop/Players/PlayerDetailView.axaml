<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:players="using:HockeySim.Desktop.Players"
             x:Class="HockeySim.Desktop.Players.PlayerDetailView"
             x:DataType="players:PlayerDetailViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Classes="badge" Width="46" Height="46">
          <TextBlock Text="{Binding Number}" FontSize="15" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="PlayerNameText"
                     Text="{Binding FullName}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding TeamName}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid DockPanel.Dock="Top"
          Margin="12,10"
          ColumnDefinitions="*,*,*,Auto"
          RowDefinitions="Auto,Auto"
          RowSpacing="2">
      <TextBlock Classes="label" Text="POSITION" />
      <TextBlock Grid.Column="1" Classes="label" Text="AGE" />
      <TextBlock Grid.Column="2" Classes="label" Text="LINEUP" />
      <TextBlock Grid.Column="3" Classes="label" Text="OVR" />
      <TextBlock Grid.Row="1" Text="{Binding Position}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Age}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LineupRole}" FontWeight="SemiBold" />
      <TextBlock x:Name="PlayerOverallText"
                 Grid.Row="1"
                 Grid.Column="3"
                 Text="{Binding Overall}"
                 FontWeight="Bold"
                 Foreground="{Binding Overall, Converter={StaticResource RatingBrush}}" />
    </Grid>

    <Border DockPanel.Dock="Top" Classes="divider" />

    <StackPanel x:Name="SeasonStatistics" DockPanel.Dock="Top" Margin="12,10" Spacing="6">
      <TextBlock Classes="label" Text="{Binding SeasonTitle}" />
      <ItemsControl ItemsSource="{Binding SeasonStatistics}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="players:SeasonStatViewModel">
            <StackPanel Spacing="1" ToolTip.Tip="{Binding Description}">
              <TextBlock Classes="label" Text="{Binding Label}" />
              <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Classes="caption" Text="{Binding SeasonCaption}" IsVisible="{Binding HasSeasonCaption}" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="divider" />

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding RatingGroups}" Margin="12,6,12,12">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="players:RatingGroupViewModel">
            <StackPanel Margin="0,6,0,4" Spacing="3">
              <TextBlock Classes="label" Text="{Binding Name}" Margin="0,0,0,2" />
              <ItemsControl ItemsSource="{Binding Ratings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="players:RatingLineViewModel">
                    <Grid ColumnDefinitions="*,70,30" ColumnSpacing="8" Height="20">
                      <TextBlock Classes="cell" Text="{Binding Name}" />
                      <ProgressBar Grid.Column="1"
                                   Classes="rating-bar"
                                   Value="{Binding Value}"
                                   Foreground="{Binding Value, Converter={StaticResource RatingBrush}}" />
                      <TextBlock Grid.Column="2"
                                 Classes="rating"
                                 HorizontalAlignment="Right"
                                 Text="{Binding Value}"
                                 Foreground="{Binding Value, Converter={StaticResource RatingBrush}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
