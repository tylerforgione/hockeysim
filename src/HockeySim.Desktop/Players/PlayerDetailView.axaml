<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:players="using:HockeySim.Desktop.Players"
             x:Class="HockeySim.Desktop.Players.PlayerDetailView"
             x:DataType="players:PlayerDetailViewModel">
  <DockPanel>
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
        <Border Classes="badge" Width="46" Height="46">
          <TextBlock Text="{Binding Number}" FontSize="15" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock x:Name="PlayerNameText"
                     Text="{Binding FullName}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="caption" Text="{Binding TeamName}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid DockPanel.Dock="Top"
          Margin="12,10"
          ColumnDefinitions="*,*,*,Auto"
          RowDefinitions="Auto,Auto"
          RowSpacing="2">
      <TextBlock Classes="label" Text="POSITION" />
      <TextBlock Grid.Column="1" Classes="label" Text="AGE" />
      <TextBlock Grid.Column="2" Classes="label" Text="LINEUP" />
      <TextBlock Grid.Column="3" Classes="label" Text="OVR" />
      <TextBlock Grid.Row="1" Text="{Binding Position}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Age}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LineupRole}" FontWeight="SemiBold" />
      <TextBlock x:Name="PlayerOverallText"
                 Grid.Row="1"
                 Grid.Column="3"
                 Text="{Binding Overall}"
                 FontWeight="Bold"
                 Foreground="{Binding Overall, Converter={StaticResource RatingBrush}}" />
    </Grid>

    <Grid x:Name="Biography"
          DockPanel.Dock="Top"
          Margin="12,0,12,10"
          ColumnDefinitions="*,*,*"
          RowDefinitions="Auto,Auto"
          RowSpacing="2">
      <TextBlock Classes="label" Text="HEIGHT" />
      <TextBlock Grid.Column="1" Classes="label" Text="WEIGHT" />
      <TextBlock Grid.Column="2" Classes="label" Text="{Binding HandednessLabel}" />
      <TextBlock Grid.Row="1" Text="{Binding Height}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Weight}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Handedness}" FontWeight="SemiBold" />
    </Grid>

    <Grid DockPanel.Dock="Top"
          Margin="12,0,12,10"
          ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto,Auto"
          ColumnSpacing="10"
          RowSpacing="3">
      <TextBlock Classes="label" VerticalAlignment="Center" Text="BORN" />
      <TextBlock Grid.Row="1" Classes="label" VerticalAlignment="Center" Text="BIRTHPLACE" />
      <TextBlock Grid.Row="2" Classes="label" VerticalAlignment="Center" Text="NATIONALITY" />
      <TextBlock Grid.Column="1" Text="{Binding BirthDate}" FontWeight="SemiBold" />
      <TextBlock Grid.Row="1"
                 Grid.Column="1"
                 Text="{Binding Birthplace}"
                 FontWeight="SemiBold"
                 TextTrimming="CharacterEllipsis"
                 ToolTip.Tip="{Binding Birthplace}" />
      <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Nationality}" FontWeight="SemiBold" />
    </Grid>

    <StackPanel x:Name="Health" DockPanel.Dock="Top" Margin="12,0,12,10" Spacing="3">
      <TextBlock Classes="label" Text="HEALTH" />
      <TextBlock x:Name="HealthText"
                 Text="{Binding Health}"
                 FontWeight="SemiBold"
                 Classes.error="{Binding IsOut}"
                 Classes.warning="{Binding IsPlayingHurt}" />
      <ItemsControl ItemsSource="{Binding Injuries}" IsVisible="{Binding HasInjuries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="players:PlayerInjuryViewModel">
            <StackPanel Margin="0,2,0,0" Spacing="1">
              <TextBlock FontWeight="SemiBold">
                <Run Text="{Binding Name}" />
                <Run Text="·" Foreground="{DynamicResource SecondaryTextBrush}" />
                <Run Text="{Binding Status}" />
              </TextBlock>
              <TextBlock Classes="caption" Text="{Binding ExpectedReturn}" />
              <TextBlock Classes="caption" Text="{Binding Effect}" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <Border DockPanel.Dock="Top" Classes="divider" />

    <!-- The full statistic line is long, so it scrolls together with the ratings. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <StackPanel x:Name="SeasonStatistics" Margin="12,10" Spacing="6">
          <TextBlock Classes="label" Text="{Binding SeasonTitle}" />
          <TextBlock Classes="caption" Text="{Binding SeasonCaption}" IsVisible="{Binding HasSeasonCaption}" />
          <ItemsControl ItemsSource="{Binding SeasonStatisticGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="players:SeasonStatGroupViewModel">
                <StackPanel Margin="0,4,0,2" Spacing="3">
                  <TextBlock Classes="label" Text="{Binding Name}" Opacity="0.8" />
                  <ItemsControl ItemsSource="{Binding Statistics}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="5" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="players:SeasonStatViewModel">
                        <StackPanel Margin="0,0,0,4" Spacing="1" ToolTip.Tip="{Binding Description}">
                          <TextBlock Classes="label" Text="{Binding Label}" />
                          <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="divider" />

        <ItemsControl ItemsSource="{Binding RatingGroups}" Margin="12,6,12,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="players:RatingGroupViewModel">
              <StackPanel Margin="0,6,0,4" Spacing="3">
                <TextBlock Classes="label" Text="{Binding Name}" Margin="0,0,0,2" />
                <ItemsControl ItemsSource="{Binding Ratings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="players:RatingLineViewModel">
                      <Grid ColumnDefinitions="*,70,30" ColumnSpacing="8" Height="20">
                        <TextBlock Classes="cell" Text="{Binding Name}" />
                        <ProgressBar Grid.Column="1"
                                     Classes="rating-bar"
                                     Value="{Binding Value}"
                                     Foreground="{Binding Value, Converter={StaticResource RatingBrush}}" />
                        <TextBlock Grid.Column="2"
                                   Classes="rating"
                                   HorizontalAlignment="Right"
                                   Text="{Binding Value}"
                                   Foreground="{Binding Value, Converter={StaticResource RatingBrush}}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
