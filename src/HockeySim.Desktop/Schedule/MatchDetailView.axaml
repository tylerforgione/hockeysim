<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:players="using:HockeySim.Desktop.Players"
             xmlns:schedule="using:HockeySim.Desktop.Schedule"
             xmlns:tables="using:HockeySim.Desktop.Tables"
             xmlns:theme="using:HockeySim.Desktop.Theme"
             x:Class="HockeySim.Desktop.Schedule.MatchDetailView"
             x:DataType="schedule:MatchDetailViewModel">
  <UserControl.DataTemplates>
    <!-- One team's full box score on the Players tab. -->
    <DataTemplate x:DataType="schedule:MatchSideViewModel">
      <StackPanel>
        <Border Classes="table-header">
          <Grid ColumnDefinitions="*,36,32,32,32,36,52,36,36,44,36,36,48,32,32,36,36,36,48,48">
            <tables:SortHeader Column="name" Label="{Binding TeamName, Converter={x:Static theme:UpperCaseConverter.Instance}}" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" />
            <tables:SortHeader Grid.Column="1" Column="position" Label="POS" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Position" />
            <tables:SortHeader Grid.Column="2" Column="goals" Label="G" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Goals" />
            <tables:SortHeader Grid.Column="3" Column="assists" Label="A" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Assists" />
            <tables:SortHeader Grid.Column="4" Column="points" Label="P" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Points" />
            <tables:SortHeader Grid.Column="5" Column="plus-minus" Label="+/-" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Plus/minus" />
            <tables:SortHeader Grid.Column="6" Column="time-on-ice" Label="TOI" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Time on ice" />
            <tables:SortHeader Grid.Column="7" Column="shots" Label="SOG" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Shots on goal" />
            <tables:SortHeader Grid.Column="8" Column="shot-attempts" Label="ATT" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Shot attempts" />
            <tables:SortHeader Grid.Column="9" Column="expected-goals" Label="xG" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Expected goals" />
            <tables:SortHeader Grid.Column="10" Column="hits" Label="HIT" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Hits" />
            <tables:SortHeader Grid.Column="11" Column="blocked-shots" Label="BLK" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Blocked shots" />
            <tables:SortHeader Grid.Column="12" Column="faceoffs" Label="FO" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Faceoffs won–lost" />
            <tables:SortHeader Grid.Column="13" Column="takeaways" Label="TK" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Takeaways" />
            <tables:SortHeader Grid.Column="14" Column="giveaways" Label="GV" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Giveaways" />
            <tables:SortHeader Grid.Column="15" Column="penalty-minutes" Label="PIM" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Penalty minutes" />
            <tables:SortHeader Grid.Column="16" Column="power-play-goals" Label="PPG" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Power-play goals" />
            <tables:SortHeader Grid.Column="17" Column="shorthanded-goals" Label="SHG" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="Shorthanded goals" />
            <tables:SortHeader Grid.Column="18" Column="corsi-percentage" Label="CF%" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="5-on-5 Corsi percentage: share of shot attempts while on the ice" />
            <tables:SortHeader Grid.Column="19" Column="expected-goals-percentage" Label="xGF%" Sort="{Binding Sort}" Command="{Binding SortSkatersCommand}" HorizontalContentAlignment="Center" ToolTip.Tip="5-on-5 share of expected goals while on the ice" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Skaters}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="schedule:SkaterBoxScoreRowViewModel">
              <Grid ColumnDefinitions="*,36,32,32,32,36,52,36,36,44,36,36,48,32,32,36,36,36,48,48" Height="22" Margin="8,0">
                <Button Classes="cell-link" HorizontalAlignment="Left" Command="{Binding OpenPlayerCommand}">
                  <TextBlock Classes="cell" Text="{Binding Name}" />
                </Button>
                <TextBlock Grid.Column="1" Classes="cell-center muted" Text="{Binding Position}" />
                <TextBlock Grid.Column="2" Classes="cell-center" Text="{Binding Goals}" />
                <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Assists}" />
                <TextBlock Grid.Column="4" Classes="cell-center strong" Text="{Binding Points}" />
                <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding PlusMinus}" />
                <TextBlock Grid.Column="6" Classes="cell-center" Text="{Binding TimeOnIce}" />
                <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Shots}" />
                <TextBlock Grid.Column="8" Classes="cell-center" Text="{Binding ShotAttempts}" />
                <TextBlock Grid.Column="9" Classes="cell-center" Text="{Binding ExpectedGoals}" />
                <TextBlock Grid.Column="10" Classes="cell-center" Text="{Binding Hits}" />
                <TextBlock Grid.Column="11" Classes="cell-center" Text="{Binding BlockedShots}" />
                <TextBlock Grid.Column="12" Classes="cell-center" Text="{Binding Faceoffs}" />
                <TextBlock Grid.Column="13" Classes="cell-center" Text="{Binding Takeaways}" />
                <TextBlock Grid.Column="14" Classes="cell-center" Text="{Binding Giveaways}" />
                <TextBlock Grid.Column="15" Classes="cell-center" Text="{Binding PenaltyMinutes}" />
                <TextBlock Grid.Column="16" Classes="cell-center" Text="{Binding PowerPlayGoals}" />
                <TextBlock Grid.Column="17" Classes="cell-center" Text="{Binding ShorthandedGoals}" />
                <TextBlock Grid.Column="18" Classes="cell-center" Text="{Binding CorsiPercentage}" />
                <TextBlock Grid.Column="19" Classes="cell-center" Text="{Binding ExpectedGoalsPercentage}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="table-header" Margin="0,6,0,0">
          <Grid ColumnDefinitions="*,40,40,40,48,48,52,52">
            <TextBlock Text="GOALIE" />
            <TextBlock Grid.Column="1" Text="SA" ToolTip.Tip="Shots against" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="SV" ToolTip.Tip="Saves" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="GA" ToolTip.Tip="Goals against" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="SV%" ToolTip.Tip="Save percentage" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="xGA" ToolTip.Tip="Expected goals against" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="GSAx" ToolTip.Tip="Goals saved above expected" HorizontalAlignment="Center" />
            <TextBlock Grid.Column="7" Text="TOI" ToolTip.Tip="Time on ice" HorizontalAlignment="Center" />
          </Grid>
        </Border>
        <Grid ColumnDefinitions="*,40,40,40,48,48,52,52" Height="22" Margin="8,0">
          <Button Classes="cell-link" HorizontalAlignment="Left" Command="{Binding Goalie.OpenPlayerCommand}">
            <TextBlock Classes="cell" Text="{Binding Goalie.Name}" />
          </Button>
          <TextBlock Grid.Column="1" Classes="cell-center" Text="{Binding Goalie.ShotsAgainst}" />
          <TextBlock Grid.Column="2" Classes="cell-center" Text="{Binding Goalie.Saves}" />
          <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Goalie.GoalsAgainst}" />
          <TextBlock Grid.Column="4" Classes="cell-center strong" Text="{Binding Goalie.SavePercentage}" />
          <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding Goalie.ExpectedGoalsAgainst}" />
          <TextBlock Grid.Column="6" Classes="cell-center" Text="{Binding Goalie.GoalsSavedAboveExpected}" />
          <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Goalie.TimeOnIce}" />
        </Grid>
      </StackPanel>
    </DataTemplate>

    <!-- A figure by period: a column for each period played, then the total. -->
    <DataTemplate x:DataType="schedule:PeriodTableViewModel">
      <StackPanel>
        <Border Classes="table-header">
          <Grid ColumnDefinitions="*,Auto,52">
            <TextBlock Text="{Binding Title}" />
            <ItemsControl Grid.Column="1" ItemsSource="{Binding Periods}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Width="44" TextAlignment="Center" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="2" Text="T" ToolTip.Tip="Total" HorizontalAlignment="Center" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="schedule:PeriodRowViewModel">
              <Grid ColumnDefinitions="*,Auto,52" Height="22" Margin="8,0">
                <TextBlock Classes="cell strong" Text="{Binding Team}" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Classes="cell" Width="44" TextAlignment="Center" Text="{Binding}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Grid.Column="2" Classes="cell-center strong" Text="{Binding Total}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <!-- Banner: the teams in their own colours, split diagonally, with the final score between them. -->
    <Grid x:Name="MatchBanner" DockPanel.Dock="Top" Height="84" ClipToBounds="True">
      <Viewbox Stretch="Fill">
        <Canvas Width="100" Height="10">
          <Rectangle Width="100"
                     Height="10"
                     Fill="{Binding Away.Colours.Primary, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
          <Polygon Points="54,0 100,0 100,10 46,10"
                   Fill="{Binding Home.Colours.Primary, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
        </Canvas>
      </Viewbox>
      <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="16" Margin="16,0">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Button Classes="banner-title-link" Command="{Binding Away.OpenTeamCommand}">
            <Border Classes="crest"
                    Background="{Binding Away.Colours.Secondary, Converter={x:Static theme:ColourBrushConverter.Instance}}">
              <TextBlock Text="{Binding Away.TeamInitials}"
                         Foreground="{Binding Away.Colours.Primary, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
            </Border>
          </Button>
          <StackPanel VerticalAlignment="Center">
            <Button x:Name="AwayTeamLink" Classes="banner-title-link" HorizontalAlignment="Left" Command="{Binding Away.OpenTeamCommand}">
              <TextBlock x:Name="AwayTeamName"
                         Classes="match-team"
                         Text="{Binding Away.TeamName, Converter={x:Static theme:UpperCaseConverter.Instance}}"
                         Foreground="{Binding Away.Colours.Primary, Converter={x:Static theme:ReadableTextBrushConverter.Instance}}" />
            </Button>
            <TextBlock Text="{Binding Away.Record}"
                       Opacity="0.8"
                       Foreground="{Binding Away.Colours.Primary, Converter={x:Static theme:ReadableTextBrushConverter.Instance}}" />
          </StackPanel>
        </StackPanel>
        <Border Grid.Column="1" Classes="match-score">
          <StackPanel>
            <TextBlock x:Name="FinalScore" Classes="stat" HorizontalAlignment="Center">
              <Run Text="{Binding Away.Score}" />
              <Run Text="–" />
              <Run Text="{Binding Home.Score}" />
            </TextBlock>
            <TextBlock x:Name="FinalLabel"
                       Classes="label"
                       HorizontalAlignment="Center"
                       Text="{Binding FinalLabel}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center">
            <Button x:Name="HomeTeamLink" Classes="banner-title-link" HorizontalAlignment="Right" Command="{Binding Home.OpenTeamCommand}">
              <TextBlock x:Name="HomeTeamName"
                         Classes="match-team"
                         Text="{Binding Home.TeamName, Converter={x:Static theme:UpperCaseConverter.Instance}}"
                         Foreground="{Binding Home.Colours.Primary, Converter={x:Static theme:ReadableTextBrushConverter.Instance}}" />
            </Button>
            <TextBlock HorizontalAlignment="Right"
                       Text="{Binding Home.Record}"
                       Opacity="0.8"
                       Foreground="{Binding Home.Colours.Primary, Converter={x:Static theme:ReadableTextBrushConverter.Instance}}" />
          </StackPanel>
          <Button Classes="banner-title-link" Command="{Binding Home.OpenTeamCommand}">
            <Border Classes="crest"
                    Background="{Binding Home.Colours.Secondary, Converter={x:Static theme:ColourBrushConverter.Instance}}">
              <TextBlock Text="{Binding Home.TeamInitials}"
                         Foreground="{Binding Home.Colours.Primary, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
            </Border>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>

    <!-- When and where, then the tabs. The shot chart and play-by-play wait for the play-by-play to be kept. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,6">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="SummaryTabButton"
                  Classes="tab"
                  Classes.selected="{Binding IsSummaryTab}"
                  Content="Summary"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static schedule:MatchDetailTab.Summary}" />
          <Button x:Name="PlayersTabButton"
                  Classes="tab"
                  Classes.selected="{Binding IsPlayersTab}"
                  Content="Players"
                  Command="{Binding SelectTabCommand}"
                  CommandParameter="{x:Static schedule:MatchDetailTab.Players}" />
        </StackPanel>
        <TextBlock x:Name="MatchWhereAndWhen"
                   Grid.Column="1"
                   Classes="caption"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center">
          <Run Text="{Binding DateLabel}" />
          <Run Text="·" />
          <Run Text="{Binding Arena}" />
        </TextBlock>
      </Grid>
    </Border>

    <Grid>
      <ScrollViewer x:Name="SummaryTab" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsSummaryTab}">
        <StackPanel Spacing="16" Margin="12">
          <ItemsControl x:Name="PeriodTables" ItemsSource="{Binding PeriodTables}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" ColumnSpacing="12" RowSpacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <StackPanel x:Name="ScoringSummary">
            <Border Classes="table-header">
              <Grid ColumnDefinitions="80,48,200,*,56,56">
                <TextBlock Text="SCORING" />
                <TextBlock Grid.Column="1" Text="TEAM" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="GOAL" />
                <TextBlock Grid.Column="3" Text="ASSISTS" />
                <TextBlock Grid.Column="4" Text="" ToolTip.Tip="PP power play · SH shorthanded · PS penalty shot · EN empty net" />
                <TextBlock Grid.Column="5" Text="SCORE" HorizontalAlignment="Center" />
              </Grid>
            </Border>
            <TextBlock Classes="caption" Margin="8,4" Text="No goals scored by players." IsVisible="{Binding HasNoGoals}" />
            <ItemsControl ItemsSource="{Binding ScoringSummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="schedule:GoalSummaryRowViewModel">
                  <Grid ColumnDefinitions="80,48,200,*,56,56" Height="22" Margin="8,0">
                    <TextBlock Classes="cell muted" Text="{Binding Time}" />
                    <TextBlock Grid.Column="1" Classes="cell-center" Text="{Binding Team}" />
                    <Button Grid.Column="2" Classes="cell-link" HorizontalAlignment="Left" Command="{Binding OpenScorerCommand}">
                      <TextBlock Classes="cell strong" Text="{Binding Scorer}" />
                    </Button>
                    <TextBlock Grid.Column="3" Classes="cell muted" Text="Unassisted" IsVisible="{Binding IsUnassisted}" />
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding AssistLinks}" IsVisible="{Binding !IsUnassisted}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="players:PlayerLinkViewModel">
                          <StackPanel Orientation="Horizontal">
                            <Button Classes="cell-link" Command="{Binding OpenCommand}">
                              <TextBlock Classes="cell muted" Text="{Binding Text}" />
                            </Button>
                            <TextBlock Classes="cell muted" Text="{Binding Separator}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Situation}" />
                    <TextBlock Grid.Column="5" Classes="cell-center" Text="{Binding Score}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel x:Name="PenaltySummary">
            <Border Classes="table-header">
              <Grid ColumnDefinitions="80,48,200,*,160">
                <TextBlock Text="PENALTIES" />
                <TextBlock Grid.Column="1" Text="TEAM" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="PLAYER" />
                <TextBlock Grid.Column="3" Text="INFRACTION" />
                <TextBlock Grid.Column="4" Text="PENALTY" />
              </Grid>
            </Border>
            <TextBlock Classes="caption" Margin="8,4" Text="No penalties." IsVisible="{Binding HasNoPenalties}" />
            <ItemsControl ItemsSource="{Binding PenaltySummary}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="schedule:PenaltySummaryRowViewModel">
                  <Grid ColumnDefinitions="80,48,200,*,160" Height="22" Margin="8,0">
                    <TextBlock Classes="cell muted" Text="{Binding Time}" />
                    <TextBlock Grid.Column="1" Classes="cell-center" Text="{Binding Team}" />
                    <Button Grid.Column="2" Classes="cell-link" HorizontalAlignment="Left" Command="{Binding OpenPlayerCommand}">
                      <TextBlock Classes="cell" Text="{Binding Player}" />
                    </Button>
                    <TextBlock Grid.Column="3" Classes="cell" Text="{Binding Infraction}" />
                    <TextBlock Grid.Column="4" Classes="cell muted" Text="{Binding Penalty}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <!-- The teams compared, away on the left as on the scoreboard. -->
            <StackPanel x:Name="TeamComparison">
              <Border Classes="table-header">
                <Grid ColumnDefinitions="*,*,*">
                  <TextBlock Text="{Binding Away.TeamInitials}" />
                  <TextBlock Grid.Column="1" Text="TEAM COMPARISON" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Home.TeamInitials}" HorizontalAlignment="Right" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding Comparison}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="schedule:ComparisonRowViewModel">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="56,*,56" Margin="8,4">
                      <TextBlock Classes="cell strong" Text="{Binding AwayValue}" />
                      <TextBlock Grid.Column="1" Classes="cell-center muted" Text="{Binding Label}" />
                      <TextBlock Grid.Column="2" Classes="cell strong" HorizontalAlignment="Right" Text="{Binding HomeValue}" />
                      <ProgressBar Grid.Row="1"
                                   Grid.ColumnSpan="3"
                                   Margin="0,3,0,0"
                                   Classes="share-bar"
                                   Value="{Binding AwayShare}"
                                   Foreground="{Binding $parent[schedule:MatchDetailView].((schedule:MatchDetailViewModel)DataContext).Away.ChartColour, Converter={x:Static theme:ColourBrushConverter.Instance}}"
                                   Background="{Binding $parent[schedule:MatchDetailView].((schedule:MatchDetailViewModel)DataContext).Home.ChartColour, Converter={x:Static theme:ColourBrushConverter.Instance}}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="16">
              <StackPanel x:Name="ThreeStars">
                <Border Classes="table-header">
                  <Grid ColumnDefinitions="64,*,36,40,44">
                    <TextBlock Text="STARS" />
                    <TextBlock Grid.Column="1" Text="PLAYER" />
                    <TextBlock Grid.Column="2" Text="POS" ToolTip.Tip="Position" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="TEAM" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="GS" ToolTip.Tip="Game score" HorizontalAlignment="Center" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding ThreeStars}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="schedule:StarRowViewModel">
                      <Grid ColumnDefinitions="64,*,36,40,44" Margin="8,3">
                        <TextBlock Classes="cell muted" Text="{Binding Star}" />
                        <StackPanel Grid.Column="1">
                          <Button Classes="cell-link" HorizontalAlignment="Left" Command="{Binding OpenPlayerCommand}">
                            <TextBlock Classes="cell strong" Text="{Binding Name}" />
                          </Button>
                          <TextBlock Classes="caption" Text="{Binding Line}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Classes="cell-center muted" Text="{Binding Position}" />
                        <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Team}" />
                        <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding GameScore}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel x:Name="Goalies">
                <Border Classes="table-header">
                  <Grid ColumnDefinitions="40,*,32,32,32,44,44,48">
                    <TextBlock Text="TEAM" />
                    <TextBlock Grid.Column="1" Text="GOALIE" />
                    <TextBlock Grid.Column="2" Text="SA" ToolTip.Tip="Shots against" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="SV" ToolTip.Tip="Saves" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="4" Text="GA" ToolTip.Tip="Goals against" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="5" Text="SV%" ToolTip.Tip="Save percentage" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="6" Text="GSAx" ToolTip.Tip="Goals saved above expected" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="7" Text="TOI" ToolTip.Tip="Time on ice" HorizontalAlignment="Center" />
                  </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Goalies}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="schedule:GoalieSummaryRowViewModel">
                      <Grid ColumnDefinitions="40,*,32,32,32,44,44,48" Height="22" Margin="8,0">
                        <TextBlock Classes="cell" Text="{Binding Team}" />
                        <Button Grid.Column="1" Classes="cell-link" HorizontalAlignment="Left" Command="{Binding Goalie.OpenPlayerCommand}">
                          <TextBlock Classes="cell" Text="{Binding Goalie.Name}" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <TextBlock Grid.Column="2" Classes="cell-center" Text="{Binding Goalie.ShotsAgainst}" />
                        <TextBlock Grid.Column="3" Classes="cell-center" Text="{Binding Goalie.Saves}" />
                        <TextBlock Grid.Column="4" Classes="cell-center" Text="{Binding Goalie.GoalsAgainst}" />
                        <TextBlock Grid.Column="5" Classes="cell-center strong" Text="{Binding Goalie.SavePercentage}" />
                        <TextBlock Grid.Column="6" Classes="cell-center" Text="{Binding Goalie.GoalsSavedAboveExpected}" />
                        <TextBlock Grid.Column="7" Classes="cell-center" Text="{Binding Goalie.TimeOnIce}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- Each team's full box score for this match only, away team first as on the scoreboard. Each
           table needs the full width for its columns, so the teams are stacked rather than side by side. -->
      <ScrollViewer x:Name="PlayersTab" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsPlayersTab}">
        <StackPanel Spacing="16" Margin="12">
          <ContentControl x:Name="AwayBoxScore" Content="{Binding Away}" />
          <ContentControl x:Name="HomeBoxScore" Content="{Binding Home}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
