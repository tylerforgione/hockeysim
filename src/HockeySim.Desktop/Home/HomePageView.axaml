<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:home="using:HockeySim.Desktop.Home"
             x:Class="HockeySim.Desktop.Home.HomePageView"
             x:DataType="home:HomePageViewModel">
  <!-- Square panels, each its own view and view model; the tape runs the full height. -->
  <Grid ColumnDefinitions="*,*,1.25*" RowDefinitions="*,*" ColumnSpacing="6" RowSpacing="6">
    <home:UpcomingGamesPanelView DataContext="{Binding UpcomingGames}" />
    <home:StandingsPanelView Grid.Column="1" DataContext="{Binding Standings}" />
    <home:TaleOfTheTapePanelView Grid.Column="2" Grid.RowSpan="2" DataContext="{Binding TaleOfTheTape}" />
    <home:RecentResultsPanelView Grid.Row="1" DataContext="{Binding RecentResults}" />
    <home:TeamLeadersPanelView Grid.Row="1" Grid.Column="1" DataContext="{Binding TeamLeaders}" />
  </Grid>
</UserControl>
