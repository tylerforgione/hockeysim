<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HockeySim.Infrastructure\HockeySim.Infrastructure.csproj" />
    <ProjectReference Include="..\HockeySim.Management\HockeySim.Management.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    PT Sans and PT Sans Narrow are embedded for the theme. The SIL Open Font License asks that its
    text travel with the fonts, so it is copied beside the executable as well.
  -->
  <ItemGroup>
    <AvaloniaResource Include="Theme\Fonts\*.ttf" />
    <None Include="Theme\Fonts\OFL.txt"
          Link="Licenses\PT-Sans-OFL.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Players run "HockeySim"; Avalonia resource URIs use this name (avares://HockeySim/...). -->
    <AssemblyName>HockeySim</AssemblyName>
    <RootNamespace>HockeySim.Desktop</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <!--
    Publishing for a runtime identifier (dotnet publish -c Release -r osx-arm64)
    produces a self-contained, single-file build: one executable with the native
    graphics libraries beside it, which are loaded in place rather than extracted.
    Trimming, ReadyToRun, and Native AOT are deferred; see
    docs/adr/0005-self-contained-desktop-builds.md.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <!-- Players have no use for debug symbols, including those that native packages ship. -->
  <Target Name="ExcludeDebugSymbolsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
